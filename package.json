{
  "name": "unimoji",
  "version": "1.3.0",
  "description": "A TypeScript emoji toolkit for parsing, formatting, and analyzing emojis in text.",
  "keywords": [
    "emoji",
    "parser",
    "text",
    "typescript",
    "unicode"
  ],
  "license": "MIT",
  "author": "Leroy Anders",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leroyanders/unimoji.git"
  },
  "bugs": {
    "url": "https://github.com/leroyanders/unimoji/issues"
  },
  "homepage": "https://github.com/leroyanders/unimoji#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "generate:emoji": "ts-node src/scripts/generateEmojiData.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
